# Native Linux production. Copy to .env, edit paths, then run:
# docker compose --profile prod up -d --build
FILES_ROOT_PATH=/home/replace-me
FILES_UID=1000
FILES_GID=1000
FILES_ADMIN_USERNAME=admin
FILES_ADMIN_PASSWORD_PATH=./secrets/admin_password
FILES_PROVENANCE_DB_PASSWORD_PATH=./secrets/provenance_db_password
FILES_CACHE_MAX_BYTES=10737418240
FILES_CACHE_MAX_AGE_DAYS=30
FILES_EDITOR_MAX_BYTES=5242880
FILES_UPLOAD_MAX_BYTES=42949672960
FILES_TERMINAL_ENABLED=true
FILES_TERMINAL_SHELL=/bin/zsh
FILES_TERMINAL_MAX_SESSIONS=4
FILES_ROKU_ENABLED=false
FILES_ROKU_BIND_ADDRESS=127.0.0.1
FILES_ROKU_PORT=8081
# Set to an HTTP URL that the Roku can reach, for example http://192.168.1.20:8081
FILES_ROKU_STREAM_BASE_URL=
RWS_HOSTNAME=files.internal.example
RWS_SECURE_COOKIES=true
RWS_DEV_PORT=5173
RWS_DEV_POLLING=false
INGRESS_BIND_ADDRESS=0.0.0.0
INGRESS_TLS_CERT_PATH=/etc/ssl/private/internal-fullchain.pem
INGRESS_TLS_KEY_PATH=/etc/ssl/private/internal-key.pem
INGRESS_LOG_LEVEL=INFO
