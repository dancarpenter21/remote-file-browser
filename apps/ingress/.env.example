# Bind only to the server address reachable from the private LAN or VPN.
TRAEFIK_BIND_ADDRESS=192.0.2.10

# Use absolute paths so the same certificate can be used by recovery overlays.
TRAEFIK_TLS_CERT_PATH=/etc/ssl/private/internal-fullchain.pem
TRAEFIK_TLS_KEY_PATH=/etc/ssl/private/internal-key.pem

TRAEFIK_LOG_LEVEL=INFO
