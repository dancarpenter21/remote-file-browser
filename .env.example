# Copy this file to .env, then choose any existing Linux-visible directory.
# Native Linux example: /home/alice
# WSL Windows-drive example: /mnt/c/Users/Alice/rfb-test-files
RFB_ROOT_PATH=/home/replace-me
RFB_UID=1000
RFB_GID=1000
RFB_HOSTNAME=files.internal.example
RFB_BIND_ADDRESS=0.0.0.0
RFB_HTTP_PORT=80
RFB_HTTPS_PORT=443
RFB_DEV_PORT=5173
# Set true only if filesystem events do not propagate into the dev container.
RFB_DEV_POLLING=false
RFB_SECURE_COOKIES=true
# Used only by compose.direct.yaml. Prefer the same absolute paths configured
# in the sibling Traefik project so private keys are not duplicated.
RFB_TLS_CERT_PATH=/etc/ssl/private/internal-fullchain.pem
RFB_TLS_KEY_PATH=/etc/ssl/private/internal-key.pem
RFB_ADMIN_PASSWORD_PATH=./secrets/admin_password
RFB_ADMIN_USERNAME=admin
RFB_PROVENANCE_DB_PASSWORD_PATH=./secrets/provenance_db_password
RFB_CACHE_MAX_BYTES=10737418240
RFB_CACHE_MAX_AGE_DAYS=30
RFB_EDITOR_MAX_BYTES=5242880
RFB_UPLOAD_MAX_BYTES=21474836480
RFB_TERMINAL_ENABLED=true
RFB_TERMINAL_SHELL=/bin/zsh
RFB_TERMINAL_MAX_SESSIONS=4
