# Machine-specific Compose configuration. Commit only the example variants below.
.env
.env.*
!.env.example
!.env.linux.example
!.env.wsl.example

# Secret values never belong in Git; keep the tracked usage notes.
secrets/*
!secrets/README.md

# Rust build output.
target/
apps/**/target/

# Frontend dependencies, build output, test coverage, and TypeScript caches.
node_modules/
apps/**/node_modules/
apps/**/dist/
apps/**/coverage/
apps/**/*.tsbuildinfo
apps/**/vite.config.js
apps/**/vite.config.d.ts

# Local tool and editor artifacts.
.cache/
.idea/
.vscode/
.DS_Store
*.swp
*.tmp
*.log

# Local test media.
*.mp4
