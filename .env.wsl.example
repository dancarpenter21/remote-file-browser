# WSL development against a Windows directory. Copy to .env.wsl and pass with:
# docker compose --env-file .env.wsl --profile dev up --build
# The directory must already exist; Compose will not create a misspelled path.
RFB_ROOT_PATH=/mnt/c/Users/replace-me/rfb-test-files
RFB_UID=1000
RFB_GID=1000
RFB_HOSTNAME=files.internal.example
RFB_BIND_ADDRESS=0.0.0.0
RFB_HTTP_PORT=8080
RFB_HTTPS_PORT=8443
RFB_DEV_PORT=5173
# Polling is more reliable for source trees stored on Windows-mounted filesystems.
RFB_DEV_POLLING=true
RFB_SECURE_COOKIES=false
# Used only by the HTTPS recovery overlay, not by the dev profile.
RFB_TLS_CERT_PATH=/etc/ssl/private/internal-fullchain.pem
RFB_TLS_KEY_PATH=/etc/ssl/private/internal-key.pem
RFB_ADMIN_PASSWORD_PATH=./secrets/admin_password
RFB_ADMIN_USERNAME=admin
RFB_PROVENANCE_DB_PASSWORD_PATH=./secrets/provenance_db_password
RFB_CACHE_MAX_BYTES=2147483648
RFB_CACHE_MAX_AGE_DAYS=7
RFB_EDITOR_MAX_BYTES=5242880
RFB_UPLOAD_MAX_BYTES=21474836480
RFB_TERMINAL_ENABLED=true
RFB_TERMINAL_SHELL=/bin/zsh
RFB_TERMINAL_MAX_SESSIONS=4
